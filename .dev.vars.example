# Copy to .dev.vars for local development (npm run dev).
# For production, set these with: npx wrangler secret put <NAME>

# GitHub OAuth App (one app for the whole panel, created once by the operator).
# Authorization callback URL must be: https://<your-worker-domain>/oauth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Any long random string (e.g. `openssl rand -hex 32`). Signs session cookies,
# magic-link codes and OAuth state.
SESSION_SECRET=

# Transactional email (Resend free tier) for magic links. Optional in dev —
# without it, the panel shows the login link on screen instead of emailing it.
RESEND_API_KEY=
EMAIL_FROM=noreply@kantan-hp.fyi
